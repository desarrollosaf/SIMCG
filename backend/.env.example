# Plantilla de configuracion. Copiala a .env y captura los valores reales:
#     cp backend/.env.example backend/.env
# El archivo .env no se versiona.

PORT=3065

# Conexion principal (default): base cddiputados.
# DB_HOST segun donde este el servidor:
#   db                     servicio db del docker-compose local
#   host.docker.internal   MySQL/MariaDB en esta maquina y el backend en Docker
#   10.0.0.25 / mysql.interno   servidor de red (pon su IP o su nombre)
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=cddiputados

# Conexion declaranet.
DB_DECLARANET_HOST=
DB_DECLARANET_PORT=3306
DB_DECLARANET_USERNAME=
DB_DECLARANET_PASSWORD=
DB_DECLARANET_DATABASE=declaranet

# Secreto de firma del token. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800

# Correo saliente
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# API de Declaranet
DECLARANET_API_URL=
DECLARANET_CLIENT_ID=
DECLARANET_CLIENT_SECRET=
DECLARANET_USERNAME=
DECLARANET_PASSWORD=

# Carpeta donde se guardan las actas y soportes de los libros.
# En Docker es el volumen ./backend/uploads montado en /app/uploads.
# Los archivos viejos de Laravel (storage/app/public/Actas) se copian a
# <ARCHIVOS_DIR>/Actas para que los registros existentes sigan funcionando.
ARCHIVOS_DIR=/app/uploads
